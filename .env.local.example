# Copy to .env.local and fill in. .env.local is gitignored; this file is not.
# Every key below is referenced by process.env somewhere in src/ or scripts/.

# --- Supabase ---------------------------------------------------------------
# Project URL. Supabase dashboard > Project Settings > Data API > Project URL.
NEXT_PUBLIC_SUPABASE_URL=
# Public anon key, safe in the browser. Same page > API Keys > anon/public.
# Used by the browser client, SSR server client, and auth middleware.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Service role key — bypasses RLS, server-side only, never expose to the client.
# Same page > API Keys > service_role. Used by every /api route and publisher.
SUPABASE_SERVICE_ROLE_KEY=

# --- Content generation -----------------------------------------------------
# Claude API key for batch generation and single-post regeneration.
# Anthropic Console (console.anthropic.com) > API Keys.
ANTHROPIC_API_KEY=
# Pexels stock photo search, used by the photo overlay templates.
# pexels.com/api > your API key (free tier).
PEXELS_API_KEY=

# --- Scheduled publishing ---------------------------------------------------
# Shared secret guarding GET /api/publish, sent as "Authorization: Bearer <secret>".
# Any random string you choose; set the same value in Vercel and in your cron job.
# If unset, the auth check is skipped — fine locally, not in production. See CRON_SETUP.md.
CRON_SECRET=

# --- LinkedIn ---------------------------------------------------------------
# OAuth app credentials, used to refresh stored tokens.
# LinkedIn Developer Portal (developer.linkedin.com/apps) > your app > Auth.
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
# Fallback access token, used only when no valid token exists in platform_tokens.
# Generated via the LinkedIn OAuth flow.
LINKEDIN_ACCESS_TOKEN=
# Numeric company page ID for company posts (urn:li:organization:<id>).
# LinkedIn page admin view URL, or the organizationsLookup API.
LINKEDIN_ORGANIZATION_ID=
# Personal profile URN id for personal posts (urn:li:person:<id>).
# Run: node scripts/get-linkedin-urn.mjs
LINKEDIN_PERSON_URN=

# --- Facebook ---------------------------------------------------------------
# Target Page's numeric ID. Facebook Page > About, or the Graph API /me/accounts.
FACEBOOK_PAGE_ID=
# Long-lived Page access token with pages_manage_posts.
# Meta for Developers (developers.facebook.com) > Graph API Explorer / Access Token Tool.
FACEBOOK_PAGE_ACCESS_TOKEN=

# --- X (Twitter) ------------------------------------------------------------
# OAuth 1.0a app + user credentials for twitter-api-v2.
# X Developer Portal (developer.x.com) > your project/app > Keys and tokens.
X_API_KEY=
X_API_SECRET=
X_ACCESS_TOKEN=
X_ACCESS_TOKEN_SECRET=

# --- Google Business Profile ------------------------------------------------
# OAuth 2.0 client credentials.
# Google Cloud Console > APIs & Services > Credentials > OAuth 2.0 Client IDs.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Fallback refresh token, used when platform_tokens has none stored.
# Obtained from the Google OAuth consent flow with access_type=offline.
GOOGLE_REFRESH_TOKEN=
# Business Profile location ID that posts are published to (locations/<id>).
# Google Business Profile API accounts.locations.list.
GOOGLE_BUSINESS_LOCATION_ID=
